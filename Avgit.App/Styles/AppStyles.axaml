<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Avgit.App.Controls">
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource AppBackground}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <!-- Applies to the main window and every dialog (title bar, taskbar, Alt+Tab). -->
    <Setter Property="Icon" Value="/Assets/avgit-256.png" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="{StaticResource PanelAlt}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#3E3E42" />
  </Style>

  <!-- Icon above the text, set with controls:ButtonIcon.Data. The text follows the presenter's
       foreground (the global TextBlock style would otherwise keep it bright when disabled). -->
  <Style Selector="Button.toolbar.icon">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinWidth" Value="54" />
    <Setter Property="ContentTemplate">
      <DataTemplate x:DataType="x:String">
        <StackPanel Spacing="3">
          <PathIcon Width="20" Height="16" HorizontalAlignment="Center"
                    Data="{Binding $parent[Button].(controls:ButtonIcon.Data)}" />
          <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontSize="11"
                     Foreground="{Binding $parent[ContentPresenter].Foreground}" />
        </StackPanel>
      </DataTemplate>
    </Setter>
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Button.flat:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#3E3E42" />
    <Setter Property="TextBlock.Foreground" Value="{StaticResource Text}" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1177BB" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="3,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- Commit rows must touch so graph lanes run continuously between rows. -->
  <Style Selector="ListBox.commits ListBoxItem">
    <Setter Property="Padding" Value="3,0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#094771" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,6" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Expander /template/ ToggleButton#PART_toggle">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style Selector="Expander /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Expander /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource Border}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource PanelAlt}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Border}" />
  </Style>

  <Style Selector="ListBox.repotabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.repotabs ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>

  <Style Selector="ListBox.repotabs ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#35353A" />
  </Style>

  <Style Selector="ListBox.repotabs ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <Style Selector="ListBox.repotabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>

  <!-- Compact checkbox for dense diff/file rows. The Fluent template reserves more
       space than a 16-20px row can provide and clips its own border. -->
  <Style Selector="CheckBox.diffcheck">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Width="16" Height="16" CornerRadius="2"
                Background="#161B22" BorderBrush="#8B949E" BorderThickness="1">
          <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#3FB950"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{TemplateBinding IsChecked}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>

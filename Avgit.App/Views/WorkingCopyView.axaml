<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Avgit.App.Resources"
             xmlns:vm="using:Avgit.App.ViewModels"
             xmlns:views="using:Avgit.App.Views"
             x:Class="Avgit.App.Views.WorkingCopyView"
             x:DataType="vm:RepositoryViewModel">
  <Grid ColumnDefinitions="430,5,*" Background="{StaticResource AppBackground}">
    <Grid Grid.Column="0" RowDefinitions="Auto,130,Auto,*,Auto">
      <!-- Thin per-pane loading indicator (overlays the top edge). -->
      <ProgressBar Grid.Row="1" VerticalAlignment="Top" Height="2" MinHeight="2" ZIndex="1"
                   IsIndeterminate="True" IsVisible="{Binding IsLoadingStatus}" />
      <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="8,5"
              BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StagedHeader}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_UnstageSelected}" Command="{Binding UnstageSelectedCommand}" />
            <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_UnstageAll}" Command="{Binding UnstageAllCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <ListBox Grid.Row="1" ItemsSource="{Binding StagedFiles}"
               SelectedItem="{Binding SelectedStagedFile, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="26,20,*,Auto" Height="24">
              <CheckBox Grid.Column="0" Classes="diffcheck" IsChecked="{Binding Included, Mode=TwoWay}"
                        MinWidth="0" MinHeight="0" Padding="0" Margin="2,0,0,0" HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                         Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
              <TextBlock Grid.Column="2" Text="{Binding RelativePath}" FontSize="11" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding OldPath}" Classes="muted" FontSize="10"
                         IsVisible="{Binding HasOldPath}" Margin="8,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="8,5"
              BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding UnstagedHeader}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_StageSelected}" Command="{Binding StageSelectedCommand}" />
            <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_StageAll}" Command="{Binding StageAllCommand}" />
            <Button Classes="flat" Content="{x:Static res:Strings.Common_Discard}" Command="{Binding DiscardSelectedCommand}" />
            <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_DiscardAll}" Command="{Binding DiscardAllCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <ListBox Grid.Row="3" ItemsSource="{Binding UnstagedFiles}"
               SelectedItem="{Binding SelectedUnstagedFile, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="26,20,*,Auto" Height="24">
              <CheckBox Grid.Column="0" Classes="diffcheck" IsChecked="{Binding Included, Mode=TwoWay}"
                        MinWidth="0" MinHeight="0" Padding="0" Margin="2,0,0,0" HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                         Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
              <TextBlock Grid.Column="2" Text="{Binding RelativePath}" FontSize="11" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding OldPath}" Classes="muted" FontSize="10"
                         IsVisible="{Binding HasOldPath}" Margin="8,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
              BorderThickness="0,1,0,0" Padding="10,8">
        <StackPanel Spacing="6">
          <Border Background="#3D2E1E" BorderBrush="#8A5A1F" BorderThickness="1" CornerRadius="3"
                  Padding="8" IsVisible="{Binding HasConflict}">
            <StackPanel Spacing="5">
              <TextBlock Text="{Binding ConflictText}" FontSize="11" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_AbortMerge}" Command="{Binding AbortMergeCommand}"
                        IsVisible="{Binding IsMergeInProgress}" />
                <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_AbortRebase}" Command="{Binding AbortRebaseCommand}"
                        IsVisible="{Binding IsRebaseInProgress}" />
                <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_ContinueRebase}" Command="{Binding ContinueRebaseCommand}"
                        IsVisible="{Binding IsRebaseInProgress}" />
                <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_SkipCommit}" Command="{Binding SkipRebaseCommitCommand}"
                        IsVisible="{Binding IsRebaseInProgress}" />
                <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_ContinueCherryPick}" Command="{Binding CherryPickContinueCommand}"
                        IsVisible="{Binding IsCherryPickInProgress}" />
                <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_SkipCherryPick}" Command="{Binding CherryPickSkipCommand}"
                        IsVisible="{Binding IsCherryPickInProgress}" />
                <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_AbortCherryPick}" Command="{Binding CherryPickAbortCommand}"
                        IsVisible="{Binding IsCherryPickInProgress}" />
                <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_ContinueRevert}" Command="{Binding RevertContinueCommand}"
                        IsVisible="{Binding IsRevertInProgress}" />
                <Button Classes="flat" Content="{x:Static res:Strings.WorkingCopy_AbortRevert}" Command="{Binding RevertAbortCommand}"
                        IsVisible="{Binding IsRevertInProgress}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding SummaryText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
          <TextBox Text="{Binding CommitMessage, Mode=TwoWay}" PlaceholderText="{x:Static res:Strings.WorkingCopy_CommitMessagePlaceholder}"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="70" FontSize="12" />
          <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <CheckBox Content="{x:Static res:Strings.WorkingCopy_AmendLastCommit}" IsChecked="{Binding Amend, Mode=TwoWay}"
                        FontSize="11" VerticalAlignment="Center" />
              <CheckBox Content="{x:Static res:Strings.WorkingCopy_SignOff}" IsChecked="{Binding SignOff, Mode=TwoWay}"
                        FontSize="11" VerticalAlignment="Center" />
              <CheckBox Content="{x:Static res:Strings.WorkingCopy_GpgSign}" IsChecked="{Binding GpgSign, Mode=TwoWay}"
                        FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox Grid.Row="1" Content="{x:Static res:Strings.WorkingCopy_PushAfterCommitting}" IsChecked="{Binding PushAfterCommit, Mode=TwoWay}"
                      FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
              <Button Classes="toolbar" Content="{x:Static res:Strings.Main_Stash}" Command="{Binding StashCommand}" />
              <Button Classes="accent" Content="{Binding CommitButtonText}" MinWidth="110" Height="32"
                      HorizontalContentAlignment="Center"
                      Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommit}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" />

    <Grid Grid.Column="2" RowDefinitions="Auto,*">
      <!-- Thin per-pane loading indicator (overlays the top edge). -->
      <ProgressBar Grid.Row="1" VerticalAlignment="Top" Height="2" MinHeight="2" ZIndex="1"
                   IsIndeterminate="True" IsVisible="{Binding IsLoadingWorkingDiff}" />
      <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
              BorderThickness="0,0,0,1" Padding="8,5">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
          <TextBlock Text="{x:Static res:Strings.History_Context}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ContextOptions}"
                    SelectedItem="{Binding DiffContext, Mode=TwoWay}" Width="70" Height="26" FontSize="12" />
          <CheckBox Grid.Column="2" Content="{x:Static res:Strings.History_IgnoreWhitespace}" IsChecked="{Binding IgnoreWhitespace, Mode=TwoWay}"
                    FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
          <Button Grid.Column="3" Classes="flat" Content="{x:Static res:Strings.WorkingCopy_OpenFile}" Command="{Binding OpenSelectedFileCommand}" />
          <Button Grid.Column="4" Classes="flat" Content="{x:Static res:Strings.Repo_View_OpenFolder}" Command="{Binding OpenInExplorerCommand}" />
        </Grid>
      </Border>
      <views:DiffView Grid.Row="1" DataContext="{Binding WorkingDiff}" />
    </Grid>
  </Grid>
</UserControl>



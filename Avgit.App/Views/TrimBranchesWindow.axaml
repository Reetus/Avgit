<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Avgit.App.Resources"
        xmlns:vm="using:Avgit.App.ViewModels"
        x:Class="Avgit.App.Views.TrimBranchesWindow"
        x:DataType="vm:TrimBranchesViewModel"
        Title="{x:Static res:Strings.Trim_Title}" Width="860" Height="560"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="14">
    <TextBlock Grid.Row="0" Text="{Binding Description}" Classes="muted" FontSize="11"
               TextWrapping="Wrap" Margin="0,0,0,10" />

    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <CheckBox Content="{x:Static res:Strings.Trim_FetchFirst}" IsChecked="{Binding FetchFirst}" FontSize="12" Margin="0,0,18,0"
                ToolTip.Tip="{x:Static res:Strings.Trim_FetchFirstToolTip}" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,18,0">
        <TextBlock Text="{x:Static res:Strings.Trim_OlderThan}" FontSize="12" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{x:Static vm:TrimBranchesViewModel.AgeOptions}"
                  SelectedItem="{Binding SelectedAge}" MinWidth="96" FontSize="12"
                  VerticalAlignment="Center" />
      </StackPanel>
      <CheckBox Content="{x:Static res:Strings.Trim_IncludeNeverPushed}" IsChecked="{Binding IncludeNeverPushed}"
                FontSize="12" />
    </WrapPanel>

    <TextBlock Grid.Row="2" Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{StaticResource Red}"
               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

    <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3"
            Background="{StaticResource AppBackground}">
      <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="BranchList" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TrimBranchRow">
                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,5">
                  <Grid ColumnDefinitions="Auto,*,120,Auto">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" MinWidth="0"
                              VerticalAlignment="Center" ToolTip.Tip="{x:Static res:Strings.Trim_RowToolTip}" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="4,0,10,0">
                      <!-- Pills wrap to a second line instead of running into the date and
                           status columns; a pill wider than the row trims with an ellipsis. -->
                      <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="3">
                        <Border Classes="pill branch" ToolTip.Tip="{Binding Name}">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        </Border>
                        <Border Classes="pill faded" ToolTip.Tip="{Binding UpstreamText}">
                          <TextBlock Text="{Binding UpstreamText}" TextDecorations="{Binding UpstreamDecorations}" />
                        </Border>
                      </WrapPanel>
                      <TextBlock Text="{Binding Details}" Classes="muted" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding LastCommitText}" Classes="muted" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" />
                    <Border Grid.Column="3" Width="96" Padding="6,2" CornerRadius="3" VerticalAlignment="Center"
                            Background="Transparent" ToolTip.Tip="{Binding StatusToolTip}">
                      <Panel>
                        <TextBlock Text="{x:Static res:Strings.Trim_StatusMerged}" Foreground="{StaticResource Green}" FontSize="11"
                                   HorizontalAlignment="Center" IsVisible="{Binding IsMerged}" />
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                                    IsVisible="{Binding IsNotMerged}">
                          <TextBlock Text="⚠" Foreground="#D29922" FontSize="11" />
                          <TextBlock Text="{x:Static res:Strings.Trim_StatusNotMerged}" Foreground="#D29922" FontSize="11" />
                        </StackPanel>
                      </Panel>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="{Binding LoadingText}" Classes="muted" FontSize="12" Margin="12"
                   IsVisible="{Binding IsLoading}" />
        <TextBlock Text="{Binding EmptyText}" Classes="muted" FontSize="12" Margin="12"
                   IsVisible="{Binding IsEmpty}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button Content="{x:Static res:Strings.Common_Cancel}" Width="96" Height="32" Click="OnCancelClick" />
      <Button x:Name="DeleteButton" Classes="accent" Content="{Binding DeleteText}" MinWidth="140" Height="32"
              IsEnabled="{Binding CanDelete}" Click="OnDeleteClick" />
    </StackPanel>
  </Grid>
</Window>

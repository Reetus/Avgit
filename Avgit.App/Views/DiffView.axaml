<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avgit.App.ViewModels"
             xmlns:controls="using:Avgit.App.Controls"
             x:Class="Avgit.App.Views.DiffView"
             x:DataType="vm:DiffViewModel">
  <UserControl.Resources>
    <!-- Shows through transparent pixels in image diffs. -->
    <DrawingBrush x:Key="Checkerboard" TileMode="Tile" DestinationRect="0,0,16,16" Stretch="None">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#2A2A2A" Geometry="M0,0 H16 V16 H0 Z" />
          <GeometryDrawing Brush="#383838" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:DiffFileHeaderItem}">
      <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Border}"
              BorderThickness="0,1,0,1" Padding="8,5">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="flat" Content="Stage file" IsVisible="{Binding CanStage}"
                    Command="{Binding StageCommand}" CommandParameter="{Binding File}" />
            <Button Classes="flat" Content="Unstage file" IsVisible="{Binding CanUnstage}"
                    Command="{Binding UnstageCommand}" CommandParameter="{Binding File}" />
            <Button Classes="flat" Content="Discard" IsVisible="{Binding CanDiscard}"
                    Command="{Binding DiscardCommand}" CommandParameter="{Binding File}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DiffHunkHeaderItem}">
      <Border Background="#1F2A33" BorderBrush="#30404D" BorderThickness="0,1,0,1" Padding="8,4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Description}" Foreground="#8FB8D8" FontFamily="{StaticResource MonoFont}" FontSize="11"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Classes="flat" Content="Stage hunk" IsVisible="{Binding CanStage}"
                    Command="{Binding StageCommand}" CommandParameter="{Binding Hunk}" />
            <Button Classes="flat" Content="Unstage hunk" IsVisible="{Binding CanUnstage}"
                    Command="{Binding UnstageCommand}" CommandParameter="{Binding Hunk}" />
            <Button Classes="flat" Content="Discard hunk" IsVisible="{Binding CanDiscard}"
                    Command="{Binding DiscardCommand}" CommandParameter="{Binding Hunk}" />
            <Button Classes="flat" Content="Stage selected lines" IsVisible="{Binding CanStage}"
                    Command="{Binding StageSelectedLinesCommand}" CommandParameter="{Binding Hunk}" />
            <Button Classes="flat" Content="Unstage selected lines" IsVisible="{Binding CanUnstage}"
                    Command="{Binding UnstageSelectedLinesCommand}" CommandParameter="{Binding Hunk}" />
            <Button Classes="flat" Content="Discard selected lines" IsVisible="{Binding CanDiscardLines}"
                    Command="{Binding DiscardSelectedLinesCommand}" CommandParameter="{Binding Hunk}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DiffLineItem}">
      <!-- checkbox | old line no | new line no | +/- | text. Empty number sides are collapsed. -->
      <Grid ColumnDefinitions="24,Auto,Auto,16,*" Background="{Binding Background}" MinHeight="22">
        <CheckBox Grid.Column="0" Classes="diffcheck" IsChecked="{Binding Line.Selected, Mode=TwoWay}"
                  IsVisible="{Binding ShowCheckBox}" Margin="2,0,0,0" HorizontalAlignment="Left" />
        <TextBlock Grid.Column="1" Text="{Binding OldLineNo}" Foreground="{Binding LineNumberBrush}"
                   FontFamily="{StaticResource MonoFont}" FontSize="11" TextAlignment="Right" Margin="0,0,6,0"
                   Width="{Binding LineNoWidth}" IsVisible="{Binding ShowBeforeLineNo}"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding NewLineNo}" Foreground="{Binding LineNumberBrush}"
                   FontFamily="{StaticResource MonoFont}" FontSize="11" TextAlignment="Right" Margin="0,0,6,0"
                   Width="{Binding LineNoWidth}" IsVisible="{Binding ShowAfterLineNo}"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding PrefixText}" Foreground="{Binding PrefixBrush}"
                   FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{Binding Text}" Foreground="{Binding TextBrush}"
                   FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <!-- Old File / New File side by side, or one panel for an added or deleted image.
         The width follows the viewport so large images scale down instead of scrolling. -->
    <DataTemplate DataType="{x:Type vm:DiffImageItem}">
      <controls:ViewportWidthDecorator HorizontalAlignment="Left" Padding="12,10">
        <ItemsControl ItemsSource="{Binding Sides}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" ColumnSpacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DiffImageSide">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                <Border Background="{StaticResource Checkerboard}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" HorizontalAlignment="Center" IsVisible="{Binding HasImage}">
                  <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="480" />
                </Border>
                <TextBlock Text="{Binding Info}" Classes="muted" FontSize="11" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </controls:ViewportWidthDecorator>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DiffNoteItem}">
      <TextBlock Text="{Binding Text}" Classes="muted" Margin="12,8" FontStyle="Italic" FontSize="12" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*" Background="{StaticResource AppBackground}">
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
            BorderThickness="0,0,0,1" Padding="10,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="muted" FontSize="11" VerticalAlignment="Center"
                   Text="{Binding Files.Count, StringFormat='{}{0} file(s)'}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <!-- The ScrollViewer lives inside the ItemsControl template so the panel can
           virtualize: only visible lines get controls. A StackPanel inside an outer
           ScrollViewer created a control per diff line, freezing on large diffs. -->
      <ItemsControl ItemsSource="{Binding DisplayItems}">
        <ItemsControl.Template>
          <ControlTemplate>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <TextBlock Text="{Binding EmptyMessage}" Classes="muted" Margin="16" FontStyle="Italic"
                 IsVisible="{Binding IsEmpty}" />
    </Grid>
  </Grid>
</UserControl>

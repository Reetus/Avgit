<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Avgit.App.Resources"
        xmlns:vm="using:Avgit.App.ViewModels"
        xmlns:views="using:Avgit.App.Views"
        xmlns:controls="using:Avgit.App.Controls"
        x:Class="Avgit.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1360" Height="860"
        MinWidth="1100" MinHeight="650"
        Background="{StaticResource AppBackground}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+T" Command="{Binding ShowHomeCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenRepositoryCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseRepositoryCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextRepositoryCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousRepositoryCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding ReopenClosedRepositoryCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding Repository.OpenTerminalCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{StaticResource Panel}">
      <MenuItem Header="{x:Static res:Strings.Main_MenuFile}">
        <MenuItem Header="{x:Static res:Strings.Main_OpenRepository}" Command="{Binding OpenRepositoryCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_ReopenClosedRepository}" Command="{Binding ReopenClosedRepositoryCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_CloneRepository}" Command="{Binding CloneRepositoryCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_CreateRepository}" Command="{Binding InitRepositoryCommand}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.Main_CloseRepository}" Command="{Binding CloseRepositoryCommand}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.Main_SettingsMenu}" Command="{Binding SettingsCommand}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.Main_Exit}" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="{x:Static res:Strings.Main_MenuRepository}">
        <MenuItem Header="{x:Static res:Strings.Common_Refresh}" Command="{Binding Repository.RefreshCommand}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.Main_Fetch}" Command="{Binding Repository.FetchCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_FetchAllRemotes}" Command="{Binding Repository.FetchAllCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_Pull}" Command="{Binding Repository.PullCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_PullWithRebase}" Command="{Binding Repository.PullRebaseCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_Push}" Command="{Binding Repository.PushCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_PushToRemote}" Command="{Binding Repository.PushToRemoteCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_ForcePushWithLease}" Command="{Binding Repository.ForcePushCommand}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.Main_CreateBranch}" Command="{Binding Repository.CreateBranchCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_CreateTag}" Command="{Binding Repository.CreateTagCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_StashChanges}" Command="{Binding Repository.StashCommand}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.Main_AdvancedGit}" Click="OnAdvancedGitClick" />
        <MenuItem Header="{x:Static res:Strings.Main_OpenInFileExplorer}" Command="{Binding Repository.OpenInExplorerCommand}" />
        <MenuItem Header="{x:Static res:Strings.Main_OpenInTerminal}" Command="{Binding Repository.OpenTerminalCommand}" InputGesture="Ctrl+Shift+C" />
      </MenuItem>
      <MenuItem Header="{x:Static res:Strings.Main_MenuHelp}">
        <MenuItem Header="{x:Static res:Strings.Main_CheckForUpdates}" Command="{Binding CheckForUpdatesCommand}" />
        <Separator />
        <MenuItem Header="{x:Static res:Strings.Main_AboutAvgit}" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,1" Padding="6,2">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <ListBox x:Name="RepositoryTabs" Grid.Column="0" Classes="repotabs"
                 ItemsSource="{Binding Repositories}"
                 SelectedItem="{Binding Repository, Mode=TwoWay}"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="10,5" Background="Transparent">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{x:Static res:Strings.Common_Close}" Click="OnTabCloseClick" />
                    <MenuItem Header="{x:Static res:Strings.Main_CloseOthers}" Click="OnTabCloseOthersClick" />
                    <MenuItem Header="{x:Static res:Strings.Main_CloseAll}" Click="OnTabCloseAllClick" />
                    <Separator />
                    <MenuItem Header="{x:Static res:Strings.Main_CopyRepositoryPath}" Click="OnTabCopyPathClick" />
                  </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                             Opacity="{Binding TabOpacity}"
                             MaxWidth="260" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Path}" />
                  <Button Classes="flat" Content="×" FontSize="14" Width="20" Height="20"
                          Padding="0" MinWidth="0" MinHeight="0"
                          ToolTip.Tip="{x:Static res:Strings.Main_CloseRepositoryToolTip}"
                          Command="{Binding $parent[ListBox].DataContext.CloseRepositoryCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ProgressBar Grid.Column="1" Width="70" Height="4" IsIndeterminate="True"
                     IsVisible="{Binding IsHomeBusy}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button Grid.Column="2" Classes="flat" Content="+" FontSize="18" Width="32" Height="30"
                Margin="6,0,0,0" VerticalAlignment="Center"
                ToolTip.Tip="{x:Static res:Strings.Main_HomeToolTip}"
                Command="{Binding ShowHomeCommand}" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource PanelAlt}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,1" Padding="8,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding ShowRepositoryContent}">
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconOpen}"
                  Content="{x:Static res:Strings.Common_Open}" Command="{Binding OpenRepositoryCommand}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconRefresh}"
                  Content="{x:Static res:Strings.Common_Refresh}" Command="{Binding Repository.RefreshCommand}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconFetch}"
                  Content="{x:Static res:Strings.Main_Fetch}" Command="{Binding Repository.FetchCommand}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconPull}"
                  Content="{x:Static res:Strings.Main_Pull}" Command="{Binding Repository.PullCommand}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconPush}"
                  Content="{x:Static res:Strings.Main_Push}" Command="{Binding Repository.PushCommand}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconCommit}"
                  Content="{x:Static res:Strings.Main_Commit}" Command="{Binding Repository.CommitCommand}"
                  IsEnabled="{Binding Repository.CanCommit, FallbackValue=False}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconBranch}"
                  Content="{x:Static res:Strings.Main_Branch}" Command="{Binding Repository.CreateBranchCommand}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconTag}"
                  Content="{x:Static res:Strings.Main_Tag}" Command="{Binding Repository.CreateTagCommand}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconStash}"
                  Content="{x:Static res:Strings.Main_Stash}" Command="{Binding Repository.StashCommand}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconTerminal}"
                  Content="{x:Static res:Strings.Main_Terminal}" Command="{Binding Repository.OpenTerminalCommand}"
                  ToolTip.Tip="{x:Static res:Strings.Main_TerminalToolTip}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconRemote}"
                  Content="{x:Static res:Strings.Main_Remote}" Command="{Binding Repository.OpenRemoteCommand}"
                  IsVisible="{Binding Repository.HasRemoteWebUrl, FallbackValue=False}"
                  ToolTip.Tip="{Binding Repository.RemoteWebUrlToolTip, FallbackValue=''}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                    VerticalAlignment="Center" IsVisible="{Binding ShowRepositoryContent}">
          <PathIcon Data="{StaticResource IconWorktree}" Width="14" Height="12" Foreground="#58A6FF"
                    Background="Transparent" VerticalAlignment="Center"
                    IsVisible="{Binding Repository.IsLinkedWorktree, FallbackValue=False}"
                    ToolTip.Tip="{Binding Repository.MainWorktreePath, StringFormat={x:Static res:Strings.Main_LinkedWorktreeOfFormat}, FallbackValue=''}" />
          <TextBlock Text="{Binding Repository.BranchAndRevisionText}" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <ProgressBar Width="90" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                       IsVisible="{Binding Repository.IsBusy, FallbackValue=False}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Data="{StaticResource IconSettings}"
                  Content="{x:Static res:Strings.Common_Settings}" Command="{Binding SettingsCommand}" Margin="0" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource PanelAlt}" IsVisible="{Binding IsUpdateReady}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding UpdateReadyText}" FontSize="12" VerticalAlignment="Center" />
        <Button Classes="accent" Content="{x:Static res:Strings.Main_RestartToUpdate}" Command="{Binding RestartToUpdateCommand}" />
        <TextBlock Text="{x:Static res:Strings.Main_UpdateInstallsNextStart}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="8,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="{Binding Repository.BranchAndRevisionText}" FontSize="11" Foreground="#58A6FF"
                   VerticalAlignment="Center" IsVisible="{Binding ShowRepositoryContent}" />
        <TextBlock Grid.Column="1" Text="{Binding Repository.StatusMessage}" Classes="muted" FontSize="11"
                   VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding ShowRepositoryContent}" />
        <TextBlock Grid.Column="1" Text="{Binding HomeStatusMessage}" Classes="muted" FontSize="11"
                   VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding WelcomeVisible}" />
        <TextBlock Grid.Column="2" Text="{Binding Repository.Path}" Classes="muted" FontSize="10"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480"
                   IsVisible="{Binding ShowRepositoryContent}" />
      </Grid>
    </Border>

    <Grid>
      <views:WelcomeView IsVisible="{Binding WelcomeVisible}" />
      <Grid IsVisible="{Binding ShowRepositoryContent}">
        <views:RepositoryView DataContext="{Binding Repository}" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>

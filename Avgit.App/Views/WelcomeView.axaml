<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Avgit.App.ViewModels"
             xmlns:res="using:Avgit.App.Resources"
             x:Class="Avgit.App.Views.WelcomeView"
             x:DataType="vm:MainWindowViewModel">
  <Grid Background="{StaticResource AppBackground}">
    <StackPanel Width="760" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
      <TextBlock Text="Avgit" Classes="h1" />
      <TextBlock Text="{x:Static res:Strings.Welcome_Tagline}"
                 Classes="muted" FontSize="14" />

      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
        <Button Classes="accent" Content="{x:Static res:Strings.Welcome_OpenRepository}" Width="170" Height="38"
                Command="{Binding OpenRepositoryCommand}" />
        <Button Classes="toolbar" Content="{x:Static res:Strings.Welcome_CloneRepository}" Width="170" Height="38"
                Command="{Binding CloneRepositoryCommand}" />
        <Button Classes="toolbar" Content="{x:Static res:Strings.Welcome_CreateRepository}" Width="170" Height="38"
                Command="{Binding InitRepositoryCommand}" />
      </StackPanel>

      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
              BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,12,0,0">
        <StackPanel Spacing="8">
          <TextBlock Text="{x:Static res:Strings.Welcome_RecentRepositories}" Classes="h2" FontSize="13" />
          <ListBox ItemsSource="{Binding RecentRepositories}" MaxHeight="260">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Height="30">
                  <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Content="{Binding}" FontSize="12"
                          Command="{Binding $parent[ListBox].DataContext.OpenRecentCommand}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Column="1" Classes="flat" Content="{x:Static res:Strings.Welcome_Remove}" FontSize="10"
                          Command="{Binding $parent[ListBox].DataContext.RemoveRecentCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <TextBlock Text="{x:Static res:Strings.Welcome_FeatureSummary}"
                 Classes="muted" FontSize="11" Margin="0,8,0,0" />
    </StackPanel>
  </Grid>
</UserControl>

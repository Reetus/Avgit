<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:Avgit.App.Resources"
        xmlns:vm="using:Avgit.App.ViewModels"
        x:Class="Avgit.App.Views.InteractiveRebaseWindow"
        x:DataType="vm:InteractiveRebaseWindowViewModel"
        Title="{x:Static res:Strings.Rebase_Title}" Width="860" Height="560"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="14">
    <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Rebase_Instructions}"
               Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />

    <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3"
            Background="{StaticResource AppBackground}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Rows}" Margin="6">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="82,130,*,32,32" Margin="0,3">
                <TextBlock Grid.Column="0" Text="{Binding ShortSha}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                           VerticalAlignment="Center" Foreground="#58A6FF" />
                <ComboBox Grid.Column="1" Margin="4,0"
                          ItemsSource="{x:Static vm:RebasePlanRow.Actions}"
                          SelectedItem="{Binding Action, Mode=TwoWay}" Height="28" FontSize="11"
                          VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Text="{Binding Message, Mode=TwoWay}" Height="52" FontSize="11"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         IsEnabled="{Binding IsReword}" ToolTip.Tip="{x:Static res:Strings.Rebase_MessageToolTip}" />
                <Button Grid.Column="3" Classes="flat" Content="↑" FontSize="14" Margin="2,0"
                        ToolTip.Tip="{x:Static res:Strings.Rebase_MoveUp}"
                        Command="{Binding $parent[ItemsControl].DataContext.MoveUpCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="4" Classes="flat" Content="↓" FontSize="14" Margin="2,0"
                        ToolTip.Tip="{x:Static res:Strings.Rebase_MoveDown}"
                        Command="{Binding $parent[ItemsControl].DataContext.MoveDownCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button Content="{x:Static res:Strings.Common_Cancel}" Width="96" Height="32" Click="OnCancelClick" />
      <Button Classes="accent" Content="{x:Static res:Strings.Rebase_RunRebase}" Width="120" Height="32" Click="OnRunClick" />
    </StackPanel>
  </Grid>
</Window>

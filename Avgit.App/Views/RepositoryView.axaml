<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Avgit.App.Resources"
             xmlns:vm="using:Avgit.App.ViewModels"
             xmlns:views="using:Avgit.App.Views"
             x:Class="Avgit.App.Views.RepositoryView"
             x:DataType="vm:RepositoryViewModel">
  <Grid ColumnDefinitions="245,5,*" Background="{StaticResource AppBackground}">
    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
            BorderThickness="0,0,1,0">
      <ScrollViewer>
        <StackPanel Margin="4,6,4,12">
          <Expander IsExpanded="True" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Expander.Header>
              <StackPanel Classes="section" Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconBranch}" />
                <TextBlock Text="{x:Static res:Strings.Repo_View_BranchesHeader}" />
              </StackPanel>
            </Expander.Header>
            <StackPanel HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="flat" Content="{x:Static res:Strings.Repo_View_NewBranch}" HorizontalAlignment="Left"
                        Command="{Binding CreateBranchCommand}" />
                <Button Classes="flat" Content="{x:Static res:Strings.Repo_View_TrimBranches}"
                        Command="{Binding TrimBranchesCommand}"
                        ToolTip.Tip="{x:Static res:Strings.Repo_View_TrimBranchesToolTip}" />
              </StackPanel>
              <ListBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                       DoubleTapped="OnBranchDoubleTapped" HorizontalAlignment="Stretch">
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{x:Static res:Strings.Repo_View_Checkout}" Command="{Binding CheckoutBranchCommand}"
                              CommandParameter="{Binding SelectedBranch}"
                              IsVisible="{Binding !SelectedBranch.IsInOtherWorktree, FallbackValue=True}" />
                    <MenuItem Header="{x:Static res:Strings.Repo_View_OpenWorktree}" Command="{Binding OpenBranchWorktreeCommand}"
                              CommandParameter="{Binding SelectedBranch}"
                              IsVisible="{Binding SelectedBranch.IsInOtherWorktree, FallbackValue=False}" />
                    <MenuItem Header="{x:Static res:Strings.Repo_View_CreateWorktree}" Command="{Binding AddWorktreeForBranchCommand}"
                              CommandParameter="{Binding SelectedBranch}"
                              IsVisible="{Binding SelectedBranch.CanAddWorktree, FallbackValue=False}" />
                    <MenuItem Header="{x:Static res:Strings.Repo_View_DeleteBranch}" Command="{Binding DeleteBranchCommand}"
                              CommandParameter="{Binding SelectedBranch}"
                              IsVisible="{Binding SelectedBranch.CanDelete, FallbackValue=False}" />
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="14,*,Auto,Auto,Auto" Height="22">
                      <TextBlock Text="●" Foreground="#3FB950" FontSize="10" VerticalAlignment="Center"
                                 IsVisible="{Binding IsCheckedOut}" />
                      <!-- Left-aligned so the marker sits right after the name, which still trims when long. -->
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Name}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <!-- The upstream was deleted on the remote (e.g. after a pull request was merged). -->
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Repo_View_UpstreamGone}" Classes="muted" FontSize="9" Margin="5,0,0,0"
                                   VerticalAlignment="Center" Background="Transparent"
                                   IsVisible="{Binding UpstreamGone}" ToolTip.Tip="{Binding UpstreamGoneToolTip}" />
                      </Grid>
                      <!-- Checked out in another worktree: it cannot be checked out here. -->
                      <PathIcon Grid.Column="2" Data="{StaticResource IconWorktree}" Width="13" Height="11"
                                Foreground="#58A6FF" Margin="6,0,0,0" VerticalAlignment="Center"
                                Background="Transparent"
                                IsVisible="{Binding IsInOtherWorktree}" ToolTip.Tip="{Binding WorktreeToolTip}" />
                      <TextBlock Grid.Column="3" Text="{Binding UpstreamText}" Foreground="#D29922"
                                 FontSize="10" Margin="6,0" VerticalAlignment="Center" />
                      <Button Grid.Column="4" Classes="flat" Content="×" FontSize="12" Padding="4,0"
                              IsVisible="{Binding CanDelete}"
                              Command="{Binding $parent[ListBox].DataContext.DeleteBranchCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{x:Static res:Strings.Repo_View_DeleteBranch}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Expander>

          <Expander IsExpanded="True" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Expander.Header>
              <StackPanel Classes="section" Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconWorktree}" />
                <TextBlock Text="{x:Static res:Strings.Repo_View_WorktreesHeader}" />
              </StackPanel>
            </Expander.Header>
            <StackPanel HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="flat" Content="{x:Static res:Strings.Repo_View_NewWorktree}" Command="{Binding AddWorktreeCommand}"
                        ToolTip.Tip="{x:Static res:Strings.Repo_View_NewWorktreeToolTip}" />
                <Button Classes="flat" Content="{x:Static res:Strings.Repo_View_Prune}" Command="{Binding PruneWorktreesCommand}"
                        IsVisible="{Binding HasPrunableWorktrees}"
                        ToolTip.Tip="{x:Static res:Strings.Repo_View_PruneToolTip}" />
              </StackPanel>
              <TextBlock Text="{x:Static res:Strings.Repo_View_NoLinkedWorktrees}" Classes="muted" FontSize="10" Margin="8,3"
                         IsVisible="{Binding !HasLinkedWorktrees}" />
              <ListBox ItemsSource="{Binding Worktrees}" DoubleTapped="OnWorktreeDoubleTapped"
                       HorizontalAlignment="Stretch" IsVisible="{Binding HasLinkedWorktrees}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="14,*,Auto,Auto" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                      <TextBlock Text="●" Foreground="#3FB950" FontSize="10" VerticalAlignment="Center"
                                 IsVisible="{Binding IsCurrent}" />
                      <StackPanel Grid.Column="1" Margin="0,2">
                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <PathIcon Data="{StaticResource IconWorktree}" Width="11" Height="9"
                                    Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding BranchText}" Classes="muted" FontSize="10"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Badges}" Foreground="#D29922" FontSize="10"
                                     IsVisible="{Binding HasBadges}" />
                        </StackPanel>
                      </StackPanel>
                      <Button Grid.Column="2" Classes="flat" Content="{x:Static res:Strings.Common_Open}" FontSize="10" Padding="4,0"
                              IsVisible="{Binding CanOpen}" VerticalAlignment="Center"
                              Command="{Binding $parent[ListBox].DataContext.OpenWorktreeCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{x:Static res:Strings.Repo_View_OpenWorktreeToolTip}" />
                      <Button Grid.Column="3" Classes="flat" Content="×" FontSize="12" Padding="4,0"
                              IsVisible="{Binding CanRemove}" VerticalAlignment="Center"
                              Command="{Binding $parent[ListBox].DataContext.RemoveWorktreeCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{x:Static res:Strings.Repo_View_RemoveWorktreeToolTip}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Expander>

          <Expander IsExpanded="True" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Expander.Header>
              <StackPanel Classes="section" Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconRemotes}" />
                <TextBlock Text="{x:Static res:Strings.Repo_View_RemotesHeader}" />
              </StackPanel>
            </Expander.Header>
            <StackPanel HorizontalAlignment="Stretch">
              <Button Classes="flat" Content="{x:Static res:Strings.Repo_View_AddRemote}" HorizontalAlignment="Left"
                      Command="{Binding AddRemoteCommand}" />
              <TextBlock Text="{x:Static res:Strings.Repo_View_NoRemotes}" Classes="muted" FontSize="10" Margin="8,3"
                         IsVisible="{Binding !HasRemotes}" />
              <ItemsControl ItemsSource="{Binding Remotes}" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,2">
                      <StackPanel Margin="2,0">
                        <TextBlock Text="{Binding Display}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Url}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="flat" Content="{x:Static res:Strings.Repo_View_Edit}" FontSize="10" Padding="4,0"
                              ToolTip.Tip="{x:Static res:Strings.Repo_View_EditRemoteToolTip}"
                              Command="{Binding $parent[ItemsControl].DataContext.EditRemoteCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2" Classes="flat" Content="×" FontSize="12" Padding="4,0"
                              ToolTip.Tip="{x:Static res:Strings.Repo_View_RemoveRemoteToolTip}"
                              Command="{Binding $parent[ItemsControl].DataContext.DeleteRemoteCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>

          <Expander IsExpanded="True" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Expander.Header>
              <StackPanel Classes="section" Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconRemoteBranches}" />
                <TextBlock Text="{x:Static res:Strings.Repo_View_RemoteBranchesHeader}" />
              </StackPanel>
            </Expander.Header>
            <StackPanel HorizontalAlignment="Stretch">
              <TextBlock Text="{x:Static res:Strings.Repo_View_NoRemoteBranches}" Classes="muted" FontSize="10" Margin="8,3"
                         IsVisible="{Binding !HasRemoteBranches}" />
              <ListBox ItemsSource="{Binding RemoteBranches}" SelectedItem="{Binding SelectedRemoteBranch, Mode=TwoWay}" DoubleTapped="OnBranchDoubleTapped"
                       HorizontalAlignment="Stretch">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*" Height="22">
                      <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Expander>

          <Expander IsExpanded="True" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Expander.Header>
              <StackPanel Classes="section" Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconTag}" />
                <TextBlock Text="{x:Static res:Strings.Repo_View_TagsHeader}" />
              </StackPanel>
            </Expander.Header>
            <StackPanel HorizontalAlignment="Stretch">
              <TextBlock Text="{x:Static res:Strings.Repo_View_NoTags}" Classes="muted" FontSize="10" Margin="8,3"
                         IsVisible="{Binding !HasTags}" />
            <ListBox ItemsSource="{Binding Tags}" DoubleTapped="OnTagDoubleTapped"
                     HorizontalAlignment="Stretch">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Height="22">
                    <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Classes="flat" Content="×" FontSize="12" Padding="4,0"
                            Command="{Binding $parent[ListBox].DataContext.DeleteTagCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="{x:Static res:Strings.Repo_View_DeleteTagToolTip}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            </StackPanel>
          </Expander>

          <Expander IsExpanded="True" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch">
            <Expander.Header>
              <StackPanel Classes="section" Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconStash}" />
                <TextBlock Text="{x:Static res:Strings.Repo_View_StashesHeader}" />
              </StackPanel>
            </Expander.Header>
            <StackPanel HorizontalAlignment="Stretch">
              <Button Classes="flat" Content="{x:Static res:Strings.Repo_View_StashChanges}" HorizontalAlignment="Left"
                      Command="{Binding StashCommand}" />
              <TextBlock Text="{x:Static res:Strings.Repo_View_NoStashes}" Classes="muted" FontSize="10" Margin="8,3"
                         IsVisible="{Binding !HasStashes}" />
              <ListBox x:Name="StashList" ItemsSource="{Binding Stashes}"
                       SelectedItem="{Binding SelectedStash, Mode=TwoWay}" DoubleTapped="OnStashDoubleTapped"
                       HorizontalAlignment="Stretch">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Height="22">
                      <TextBlock Text="{Binding Display}" FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Classes="flat" Content="{x:Static res:Strings.Repo_View_ApplyStash}" FontSize="10" Padding="4,0"
                              Command="{Binding $parent[ListBox].DataContext.ApplyStashCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2" Classes="flat" Content="{x:Static res:Strings.Repo_View_PopStash}" FontSize="10" Padding="4,0"
                              Command="{Binding $parent[ListBox].DataContext.PopStashCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="3" Classes="flat" Content="×" FontSize="12" Padding="4,0"
                              Command="{Binding $parent[ListBox].DataContext.DropStashCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{x:Static res:Strings.Repo_View_DropStashToolTip}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Expander>

          <Expander IsExpanded="True">
            <Expander.Header>
              <StackPanel Classes="section" Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconRepository}" />
                <TextBlock Text="{x:Static res:Strings.Repo_View_RepositoryHeader}" />
              </StackPanel>
            </Expander.Header>
            <StackPanel Spacing="3" Margin="6,2">
              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="{Binding RepoTypeText}" Classes="muted" FontSize="10" />
              <TextBlock Text="{Binding Path}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
              <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding IsLinkedWorktree}"
                         Text="{Binding MainWorktreePath, StringFormat={x:Static res:Strings.Repo_View_MainWorktreeFormat}}" />
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                <Button Classes="flat" Content="{x:Static res:Strings.Repo_View_OpenFolder}" Command="{Binding OpenInExplorerCommand}" />
                <Button Classes="flat" Content="{x:Static res:Strings.Common_Refresh}" Command="{Binding RefreshCommand}" />
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" />

    <TabControl x:Name="MainTabs" Grid.Column="2">
      <TabItem Header="{x:Static res:Strings.Repo_View_HistoryTab}">
        <views:HistoryView />
      </TabItem>
      <TabItem Header="{x:Static res:Strings.Repo_View_FileStatusTab}">
        <views:WorkingCopyView />
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>



